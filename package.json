{
    "name": "reveal.js-simplemenu",
    "version": "2.1.0",
    "description": "A simple Reveal.js plugin for a menubar or a header or footer with an auto-generated menu",
    "homepage": "https://github.com/martinomagnifico/reveal.js-simplemenu",
    "type": "module",
    "author": {
        "name": "Martijn De Jongh (Martino)",
        "email": "martijn.de.jongh@gmail.com",
        "web": "https://martinomagnifico.github.io",
        "url": "https://martinomagnifico.github.io",
        "username": "martinomagnifico"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git://github.com/martinomagnifico/reveal.js-simplemenu.git"
    },
    "main": "./plugin/simplemenu/simplemenu.js",
    "module": "./plugin/simplemenu/simplemenu.mjs",
    "style": "./plugin/simplemenu/simplemenu.css",
    "exports": {
        ".": {
            "import": "./plugin/simplemenu/simplemenu.mjs",
            "require": "./plugin/simplemenu/simplemenu.js"
        },
        "./plugin/simplemenu/simplemenu.esm.js": "./plugin/simplemenu/simplemenu.mjs",
        "./plugin/simplemenu/simplemenu.css": "./plugin/simplemenu/simplemenu.css",
        "./simplemenu.css": "./plugin/simplemenu/simplemenu.css"
    },
    "files": [
        "plugin/simplemenu",
        "CHANGELOG.md"
    ],
    "scripts": {
        "start": "npm run dev",
        "copy-reveal": "node scripts/copy-reveal.mjs",
        "copy-plugin": "node scripts/copy-plugin.mjs",
        "dev": "vite",
        "prebuild": "rimraf demo plugin",
        "build-plugin": "vite build -c vite.lib.config.ts",
        "build-demo": "vite build -c vite.config.ts",
        "build": "npm run build-plugin && npm run build-demo && npm run copy-reveal && npm run copy-plugin",
        "format": "biome format --write .",
        "lint": "biome lint .",
        "check": "biome check --write .",
        "preview": "npm run build && vite preview",
        "ci": "biome ci ."
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.10",
        "@types/node": "^26.2.0",
        "@types/reveal.js": "^5.2.2",
        "@vituum/vite-plugin-pug": "^2.0.1",
        "fs-extra": "^11.4.0",
        "reveal.js-plugintoolkit": "^1.1.0",
        "rimraf": "^6.1.3",
        "sass": "^1.103.1",
        "typescript": "^7.0.2",
        "vite": "^8.2.2",
        "vituum": "^2.0.2"
    },
    "peerDependencies": {
        "reveal.js": ">=4.0.0"
    }
}
