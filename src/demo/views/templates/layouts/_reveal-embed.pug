extends _base.pug

//- Two decks in a column, laid out like the embed demos of the other plugins.
//- They narrow with the window, down to 390px, and at about 453px or less Reveal
//- switches them to scroll view, so embedded and scroll view can be tried together.
block content
	.embeddemo
		.reveal#deck1
			block beforeslides
			.slides
				block slides

		.reveal#deck2
			block beforeslidestwo
			.slides
				block slidestwo

block append styles
	+revealsrc("style", "dist/reset.css")
	+revealsrc("style", "dist/reveal.css")
	+revealsrc("style", `dist/theme/${presentation.theme}.css`)
	+revealsrc("style", "dist/plugin/highlight/monokai.css")

	//- Demo styles
	if process.env.NODE_ENV === 'production'
		link(rel="stylesheet" href="assets/css/demo.css")
	else
		link(rel="stylesheet" href="/src/demo/style/demo.scss")

block append scripts
	+revealsrc("script", "dist/reveal.js")
